# ============================================================================
# ZENIN SYSTEMS SOLUTIONS LLP — ENVIRONMENT CONFIGURATION
# Copy this file to .env and supply your environment-specific secrets.
# ============================================================================

# 1. Database Configuration (PostgreSQL)
# For Vercel Postgres / Neon / Managed PostgreSQL:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zenin_systems?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/zenin_systems?schema=public"

# 2. Authentication & Session Security
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
SESSION_COOKIE_NAME="zenin_admin_session"

# 3. Initial Admin Bootstrap (Used only by `pnpm db:seed` if no SUPER_ADMIN exists)
# Supply strong values in your local .env before running `pnpm db:seed`
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="System Administrator"

# 4. Application URL (Used for canonical URLs, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.zeninsystems.com"

# 5. Media Upload Configuration (Optional S3 / Cloudinary; falls back to local /public/uploads in development)
STORAGE_PROVIDER="local" # "local" | "cloudinary" | "s3"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# 6. Email Notifications (Optional Resend or SMTP; logs safely when not configured)
EMAIL_PROVIDER="console" # "console" | "resend" | "smtp"
RESEND_API_KEY=""
EMAIL_FROM="notifications@zeninsystems.com"
ADMIN_NOTIFICATION_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
