{
  "name": "zenin-systems-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-server.mjs dev",
    "build": "node scripts/prepare-prisma.mjs && prisma generate && next build",
    "postinstall": "node scripts/prepare-prisma.mjs && prisma generate",
    "start": "node scripts/start-server.mjs start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": ">=8.5.23",
    "deepmerge-ts": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "deepmerge-ts": ">=8.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.5.0",
    "jose": "^6.0.10",
    "lenis": "^1.3.27",
    "lucide-react": "^0.483.0",
    "next": "^15.5.29",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  }
}
